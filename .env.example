# =========================================
# VELOZ — variables de entorno
# Copiar a `.env.local` y completar los valores reales.
# `.env.local` está gitignoreado.
# =========================================

# --- Email (Resend) ---
# Si estas 3 variables NO están configuradas, el formulario sigue
# funcionando (guarda el lead en data/leads.json) pero no envía correo.
RESEND_API_KEY=
RESEND_FROM="VELOZ <no-reply@veloz.com.pa>"
RESEND_TO=hola@veloz.com.pa

